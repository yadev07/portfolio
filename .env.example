# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored. Never commit real keys.

# The public origin of the deployed site. Used for metadataBase, sitemap.xml,
# robots.txt and Open Graph URLs. Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form delivery (optional)
# ---------------------------------------------------------------------------
# The contact form posts to /api/contact. Until one of the variables below is
# set, the API responds with `code: "NOT_CONFIGURED"` and the form shows a
# fallback that lets the visitor copy the message or open their mail client.
# Nothing is ever exposed to the browser — these are server-only values.

# Option A — Resend (https://resend.com). See app/api/contact/route.ts.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option B — any webhook that accepts a JSON POST (Zapier, Make, Discord, n8n).
CONTACT_WEBHOOK_URL=
